# Copie para .env.local (desenvolvimento) e configure as mesmas variáveis
# na Vercel (Settings → Environment Variables) para produção.

# ── Banco de dados (Postgres) ──
# Em produção: um Postgres (recomendado: integração Neon da Vercel, que já
# cria DATABASE_URL e DATABASE_URL_UNPOOLED). As migrações rodam sozinhas no
# deploy (script vercel-build).
# Sem DATABASE_URL, o `pnpm dev` usa um Postgres embutido (PGlite) em
# .data/pglite — não precisa instalar nada.
DATABASE_URL=

# ── Conta do dono ──
# Criada automaticamente na primeira inicialização (depois, a senha vive no
# banco e pode ser trocada no painel). Gere o hash e um AUTH_SECRET com:
#   pnpm admin:hash
ADMIN_USERNAME=gaspar
ADMIN_PASSWORD_HASH=

# ── Sessões (OAuth 2.0) ──
# Trocar este valor encerra todas as sessões abertas.
AUTH_SECRET=

# ── Imagens e vídeos ──
# Criado automaticamente ao conectar um store do Vercel Blob ao projeto.
# Sem ele, os uploads vão para public/uploads (ou para UPLOADS_DIR).
BLOB_READ_WRITE_TOKEN=

# ── Servidor próprio (VPS, Docker, Coolify…) ──
# Sem DATABASE_URL, a versão de produção usa um banco EM MEMÓRIA: aponte o
# PGLITE_DIR para uma pasta persistente (ou use um Postgres em DATABASE_URL).
# PGLITE_DIR=/data/pglite
# Pasta dos uploads no disco. Num container, coloque num volume persistente.
# UPLOADS_DIR=/data/uploads
